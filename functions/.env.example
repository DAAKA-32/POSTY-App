# Cloud Functions runtime environment.
#
# Copy to functions/.env.<projectId> (production: functions/.env.tink-dc3d4).
# firebase-tools loads it at deploy time; the real file is gitignored.
# UTF-8 WITHOUT BOM, no quotes, no trailing spaces (a BOM corrupts HTTP headers).
# `firebase deploy --only functions` refuses to deploy without a valid
# TOKEN_ENCRYPTION_KEY (functions/scripts/check-deploy-env.mjs).

# REQUIRED — byte-identical to TOKEN_ENCRYPTION_KEY of the Next.js app (Vercel).
# Every OAuth token is stored AES-256-GCM encrypted with it: without it (or
# with a different value) the scheduler cannot publish anything.
TOKEN_ENCRYPTION_KEY=

# Zernio aggregator (scheduled X / Instagram / Reddit / Threads-via-Zernio).
ZERNIO_API_KEY=

# "true" to actually post queued LinkedIn seed comments (otherwise closed as
# skipped_flag_off). Replaces functions.config().posty.seed_comment_autopost.
SEED_COMMENT_AUTOPOST=false

# Daily autonomous Strategist → POST {POSTY_APP_URL}/api/strategist/auto-batch.
# CRON_SECRET must equal CRON_SECRET of the Next.js app.
POSTY_APP_URL=https://postyapp.ai
CRON_SECRET=

# Optional overrides (defaults shown).
# LINKEDIN_API_BASE_URL=https://api.linkedin.com/v2
# FACEBOOK_API_URL=https://graph.facebook.com/v21.0
# THREADS_API_URL=https://graph.threads.net/v1.0

# Legacy linkedinCallback HTTP function only (not used by the app).
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
