# The Vercel CLI does NOT honor .gitignore: without this file a CLI deploy
# (`vercel --prod --archive=tgz`) uploads every local file, secrets included.
# Vercel injects the app's env vars itself, so no .env file is needed there.
.env*
*.pem
firestore-debug.log
# Firebase Admin key and local QA artefacts — never upload (the CLI ignores .gitignore).
service-account.json
.preview-browser/
.ui-shots/
test-results/
playwright-report/
