# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local
.env.vercel-final

# Firebase Functions env (secrets — loaded by firebase-tools at deploy)
functions/.env
functions/.env.*
!functions/.env.example

# Firebase service account (sensitive!)
service-account.json
firebase-service-account.json
*-firebase-adminsdk-*.json

# Firebase local cache
.firebase/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Claude temporary files
tmpclaude-*
nul

# Claude local settings
.claude/settings.local.json

# Playwright preview-generation persistent browser context (keeps Firebase auth)
.preview-browser/

# Playwright E2E artifacts
/test-results/
/playwright-report/
/playwright/.cache/
.env.e2e

# Capacitor / iOS build artifacts
ios/App/App/public/
ios/App/Pods/
ios/App/build/
ios/App/DerivedData/
ios/App/App.xcworkspace/xcuserdata/
ios/App/App.xcodeproj/xcuserdata/
ios/App/App.xcodeproj/project.xcworkspace/xcuserdata/
ios/.gradle/
ios/capacitor-cordova-ios-plugins/
ios/App/output/
*.ipa
*.xcarchive
*.mobileprovision
*.p12
*.p8
*.cer
*.certSigningRequest
ExportOptions.plist
