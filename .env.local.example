# Firebase Configuration
# Get these values from your Firebase Console: https://console.firebase.google.com
# Project Settings > General > Your apps > Web app

NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# Optional: For future OpenAI integration
# OPENAI_API_KEY=your_openai_key_here

# ============== STRIPE CONFIGURATION ==============
# Get these values from your Stripe Dashboard: https://dashboard.stripe.com

# Publishable key (safe to expose in frontend)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key

# Secret key (NEVER expose in frontend)
STRIPE_SECRET_KEY=sk_test_your_secret_key

# Webhook secret (from Stripe Dashboard > Webhooks)
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Stripe Price IDs (create these in Stripe Dashboard > Products)
STRIPE_PRICE_PRO_MONTHLY=price_pro_monthly_id
STRIPE_PRICE_PRO_YEARLY=price_pro_yearly_id
STRIPE_PRICE_MAX_MONTHLY=price_max_monthly_id
STRIPE_PRICE_MAX_YEARLY=price_max_yearly_id

# App URLs for Stripe redirects
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============== TOKEN ENCRYPTION (REQUIRED FOR PRODUCTION) ==============
# Master key for AES-256-GCM encryption of OAuth tokens stored in Firestore
# (accessToken, refreshJwt, webhookUrl, page tokens, etc.).
#
# Generate one with: openssl rand -base64 32
# This MUST be base64-encoded exactly 32 bytes.
# Server-side only — NEVER prefix with NEXT_PUBLIC_.
# Losing/rotating this key locks users out of their connected accounts; treat
# it like the Stripe webhook secret.
TOKEN_ENCRYPTION_KEY=

# ============== ZERNIO AGGREGATOR (X + INSTAGRAM) ==============
# Posty uses Zernio (https://zernio.com) as the publishing aggregator for
# X/Twitter and Instagram. Their managed OAuth + their already-approved Meta
# app let us ship those two networks without months of platform review.
#
# Free tier: first 2 connected accounts per profile are free. We map
# 1 Posty user = 1 Zernio profile and gate users to at most X + Instagram via
# Zernio, so we stay inside the free tier.
#
# How to get a key:
#   1. Sign up at zernio.com (free)
#   2. Dashboard → API Keys → create one (format: sk_<64 hex chars>)
#   3. Dashboard → OAuth settings → set redirect URI to
#      https://postyapp.ai/api/auth/zernio/callback
#      (also add http://localhost:3000/api/auth/zernio/callback for dev)
#
# Server-side only — NEVER prefix with NEXT_PUBLIC_.
ZERNIO_API_KEY=

# ============================================
# PROSPECTION (admin seulement, /admin/outreach)
# ============================================
# Envoi par SMTP depuis une vraie boîte mail. Pas de service tiers, pas de clé
# d'API cloud : avec Gmail il faut un MOT DE PASSE D'APPLICATION (16 caractères,
# généré sur https://myaccount.google.com/apppasswords, la validation en deux
# étapes doit être active). Le mot de passe du compte ne fonctionnera pas.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=postygroup@gmail.com
SMTP_PASSWORD=xxxx xxxx xxxx xxxx

# En-tête expéditeur et adresse de réponse. Par défaut, SMTP_USER.
OUTREACH_FROM_EMAIL="Emilien de Posty <postygroup@gmail.com>"
OUTREACH_REPLY_TO=postygroup@gmail.com
OUTREACH_SENDER_NAME=Emilien
OUTREACH_SENDER_ROLE=Cofondateur

# Plafond quotidien, toutes campagnes confondues. 25 est volontairement bas :
# l'objectif est de rester invisible pour les filtres anti-spam, pas d'atteindre
# le quota Gmail. Ne montez pas au-dessus de 40 sans une bonne raison.
OUTREACH_DAILY_CAP=25

# Signe les liens de désabonnement. Reprend TOKEN_ENCRYPTION_KEY si vide.
OUTREACH_UNSUBSCRIBE_SECRET=

# Site public vers lequel pointent les liens de désabonnement. Ne reprend PAS
# NEXT_PUBLIC_BASE_URL, qui vaut http://localhost:3000 en local : le destinataire
# ouvre le lien sur sa propre machine. https obligatoire, localhost refusé.
OUTREACH_PUBLIC_URL=https://postyapp.ai

# Désinscription : "reply" (défaut) = « répondez stop » + en-tête mailto, aucune
# page requise. "link" = lien signé vers /desabonnement — uniquement une fois cette
# page déployée sur OUTREACH_PUBLIC_URL, sinon le lien mène à une 404.
OUTREACH_UNSUBSCRIBE_MODE=reply
