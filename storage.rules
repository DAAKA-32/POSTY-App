rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Profile images (avatars, covers)
    match /users/{userId}/{type}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null
                    && request.auth.uid == userId;
    }

    // Scheduled post images (temporary storage until published)
    match /scheduled-posts/{userId}/{postId}/{fileName} {
      // Anyone authenticated can read (Cloud Functions also need access via admin SDK)
      allow read: if request.auth != null
                  && request.auth.uid == userId;
      // Only the owner can upload images
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      // Only the owner can delete (Cloud Functions use admin SDK which bypasses rules)
      allow delete: if request.auth != null
                    && request.auth.uid == userId;
    }
  }
}
