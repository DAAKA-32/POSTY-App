# Posty E2E test environment — copy to .env.e2e and fill in.
# .env.e2e is gitignored. Never commit real credentials.

# Override the target. Default: http://localhost:3000 (with auto-started dev server).
# E2E_BASE_URL=https://staging.postyapp.ai

# Dedicated Firebase test account.
# Create one via Firebase Console → Authentication → Add User.
# Do NOT reuse a real production user — E2E tests may mutate data.
E2E_TEST_EMAIL=
E2E_TEST_PASSWORD=

# Optional: a second account for multi-user flows (sharing, comments, etc.)
# E2E_TEST_EMAIL_2=
# E2E_TEST_PASSWORD_2=
